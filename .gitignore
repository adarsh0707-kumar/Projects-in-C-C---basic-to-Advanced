*.zip
.lsp
.claude

# Build output. CMake configures into <project>/build, and a stray
# ./build at the repo root (currently a DigitalClock build) would
# otherwise show up as untracked on every status. These are generated
# files holding absolute machine paths -- never committed.
build/
cmake-build-*/
CMakeUserPresets.json

# Left behind by the fuseblk (NTFS) mount this repository sits on when a
# file is deleted while still open -- a build artifact of the filesystem
# rather than of the project, and never something to commit.
.fuse_hidden*
