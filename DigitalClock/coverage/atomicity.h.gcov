        -:   45:
        -:   46:namespace __gnu_cxx _GLIBCXX_VISIBILITY(default)
        -:   47:{
        -:   48:_GLIBCXX_BEGIN_NAMESPACE_VERSION
        -:   49:
        -:   50:  __attribute__((__always_inline__))
