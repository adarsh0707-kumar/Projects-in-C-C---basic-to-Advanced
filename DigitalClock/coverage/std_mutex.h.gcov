        -:  272:      typedef _Mutex mutex_type;
        -:  273:
        -:  274:      [[__nodiscard__]]
    #####:  275:      explicit lock_guard(mutex_type& __m) : _M_device(__m)
    #####:  276:      { _M_device.lock(); }
        -:  277:
