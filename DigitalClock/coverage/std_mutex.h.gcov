        -:  279:      lock_guard(mutex_type& __m, adopt_lock_t) noexcept : _M_device(__m)
        -:  280:      { } // calling thread owns mutex
        -:  281:
    #####:  282:      ~lock_guard()
    #####:  283:      { _M_device.unlock(); }
        -:  284:
